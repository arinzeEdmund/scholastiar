# Phase A — UI build. The app runs entirely on the mock data layer.
DATA_SOURCE=mock
# Simulated latency for mock reads (ms), so loading states are visible.
MOCK_LATENCY_MS=150

# Phase B — backend. See STRUCTURE/BUILD_GUIDE/ENVIRONMENT.md for the full list.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
